# Copy to .env and adjust. Every setting is optional unless marked REQUIRED.
# The Python loader reads PROPTECH_* variables; dbt reads the same names via env_var().

# ---- Where to load: duckdb (local/CI) | bigquery
PROPTECH_TARGET=duckdb
# BigQuery flavour: sandbox (no billing: no DML, 60-day expiry, 10 GiB lifetime storage) | prod
PROPTECH_ENV=sandbox
# Catalog profile from config/datasets.yml: core (~40 MB of CSV) | extended (adds city/ZIP, ~400 MB)
PROPTECH_PROFILE=core

# ---- DuckDB
PROPTECH_DUCKDB_PATH=data/warehouse/proptech.duckdb

# ---- BigQuery (REQUIRED when PROPTECH_TARGET=bigquery)
# PROPTECH_BQ_PROJECT=my-gcp-project
PROPTECH_BQ_LOCATION=US
# Prefix for every dataset (raw_zillow, raw_reference, ops, staging, intermediate, marts, seeds)
PROPTECH_BQ_DATASET_PREFIX=
# Service-account key for local runs; CI uses Workload Identity Federation instead.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# dbt target: local | sandbox | ci | prod | offline
DBT_TARGET=local

# ---- Sources (override with file:// URLs to run against tests/fixtures/sources)
PROPTECH_ZILLOW_BASE_URL=https://files.zillowstatic.com/research/public_csvs
PROPTECH_PMMS_URL=https://www.freddiemac.com/pmms/docs/PMMS_history.csv
PROPTECH_ACS_BASE_URL=https://www2.census.gov/programs-surveys/acs/summary_file
PROPTECH_ACS_YEARS=2021,2022,2023,2024

# ---- Archive of every downloaded vintage: local directory or gs://bucket/prefix
PROPTECH_RAW_ARCHIVE_URI=data/archive

# ---- Guardrails
# Stop loading when the storage ledger reaches this many GiB (sandbox lifetime quota is 10 GiB)
PROPTECH_STORAGE_BUDGET_GIB=8.0
# Sandbox tables are re-stamped to expire this many days after each run (max 60)
PROPTECH_SANDBOX_TABLE_TTL_DAYS=59
# Quarantine out-of-range values when they are at most this share of a file; fail above it
PROPTECH_MAX_REJECT_RATIO=0.001
# Per-query cap (bytes) for the loader's queries and dbt
PROPTECH_MAX_BYTES_BILLED=53687091200
# Relax row-count floors for the tiny synthetic fixtures (tests/CI only)
PROPTECH_RELAXED_VALIDATION=false

# ---- HTTP
PROPTECH_HTTP_TIMEOUT_SECONDS=120
PROPTECH_HTTP_RETRIES=5

# ---- Logging
PROPTECH_LOG_LEVEL=INFO
PROPTECH_JSON_LOGS=true
